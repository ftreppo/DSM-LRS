{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsm-lrs:SourceRecord:v1",
  "title": "SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "author_or_organization",
    "source_class",
    "source_type",
    "jurisdiction",
    "language",
    "publication_date",
    "version",
    "canonical_locator",
    "drive_file_id_or_external_url",
    "storage_mode",
    "sha256_if_stored",
    "access_state",
    "authority_level",
    "evidence_status",
    "visibility",
    "scope",
    "subjects",
    "school_stages",
    "measure_families",
    "current_status",
    "supersedes",
    "superseded_by",
    "last_verified",
    "pedagogical_review_status",
    "authority_review_status",
    "copyright_storage_note",
    "notes"
  ],
  "properties": {
    "source_id": {"type": "string","minLength": 1},
    "title": {"type": "string","minLength": 1},
    "author_or_organization": {"type": "string"},
    "source_class": {"enum": ["BINDING_INDIVIDUAL","BINDING_EXAM","OFFICIAL_SCHOOL_DSM","DSM_LRS_CANONICAL","PEDAGOGICAL_EVIDENCE","ACCESSIBILITY_REFERENCE","VERIFICATION_HISTORICAL"]},
    "source_type": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "language": {"type": "string"},
    "publication_date": {"type": ["string","null"]},
    "version": {"type": "string"},
    "canonical_locator": {"type": "string"},
    "drive_file_id_or_external_url": {"type": ["string","null"]},
    "storage_mode": {"enum": ["PHYSICAL_CANONICAL","EXTERNAL_ONLY","PRIVATE_AUTHORITY_CLASS"]},
    "sha256_if_stored": {"type": ["string","null"],"pattern": "^[0-9a-f]{64}$"},
    "access_state": {"type": "string"},
    "authority_level": {"type": "string"},
    "evidence_status": {"type": "string"},
    "visibility": {"type": "string"},
    "scope": {"type": "string"},
    "subjects": {"type": "array","items": {"type": "string"}},
    "school_stages": {"type": "array","items": {"type": "string"}},
    "measure_families": {"type": "array","items": {"type": "string"}},
    "current_status": {"enum": ["CURRENT","SUPERSEDED","RETIRED","WITHDRAWN","REFERENCE_ONLY"]},
    "supersedes": {"type": "array","items": {"type": "string"}},
    "superseded_by": {"type": "array","items": {"type": "string"}},
    "last_verified": {"type": "string"},
    "pedagogical_review_status": {"type": "string"},
    "authority_review_status": {"type": "string"},
    "copyright_storage_note": {"type": "string"},
    "notes": {"type": "string"},
    "indexing_mode": {"type": "string"}
  }
}
