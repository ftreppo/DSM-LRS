{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsm-lrs.invalid/schemas/community-adapter-example-v0.1.json",
  "title": "Community Adapter Example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "source_issue",
    "adapter_version",
    "language",
    "use_case",
    "subject",
    "objective",
    "source_material",
    "adapter_output",
    "classification",
    "privacy_review",
    "rights_review",
    "review_status"
  ],
  "properties": {
    "example_id": {"type": "string", "pattern": "^CAE-[0-9]{4}-[0-9]{3,}$"},
    "source_issue": {"type": "integer", "minimum": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "use_case": {"enum": ["STUDY", "HOMEWORK", "ASSESSMENT"]},
    "subject": {"type": "string", "minLength": 1},
    "school_stage": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "assessed_competence": {"type": ["string", "null"]},
    "source_material": {"type": "string", "minLength": 1},
    "adapter_output": {"type": "string", "minLength": 1},
    "reviewer_analysis": {"type": "string"},
    "classification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GOOD_EXAMPLE",
          "ADAPTER_WEAKNESS",
          "AMBIGUOUS",
          "ASSESSMENT_SAFETY",
          "LAYOUT",
          "LANGUAGE",
          "OCR_UNREADABLE",
          "SUBJECT_TERMINOLOGY",
          "POLICY_CONTEXT",
          "NEW_USE_CASE",
          "NO_CHANGE_NEEDED"
        ]
      }
    },
    "privacy_review": {"enum": ["PASS", "FAIL", "REDACTION_REQUIRED"]},
    "rights_review": {"enum": ["PASS", "FAIL", "CLARIFICATION_REQUIRED"]},
    "review_status": {"enum": ["PENDING", "REVIEWED", "PROMOTED", "REJECTED"]},
    "improvement_candidate_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"use_case": {"const": "ASSESSMENT"}}},
      "then": {
        "required": ["assessed_competence"],
        "properties": {"assessed_competence": {"type": "string", "minLength": 1}}
      }
    }
  ]
}
