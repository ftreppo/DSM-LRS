{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dsm-editorial-proposal/schema/document-v0.1.json",
  "title": "DSM-ES community proposal metadata v0.1",
  "description": "Non-official document schema; not an LRS authorization PolicyPack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "version",
    "status",
    "profile",
    "use_case",
    "title",
    "source_language",
    "support_languages",
    "response_languages",
    "translation_status",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "document_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "RELEASED"
      ]
    },
    "profile": {
      "enum": [
        "PARENTS",
        "STUDENTS",
        "ASSESSMENT"
      ]
    },
    "use_case": {
      "enum": [
        "NOTICE",
        "STUDY",
        "HOMEWORK",
        "ASSESSMENT"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "class_or_audience": {
      "type": "string"
    },
    "source_language": {
      "enum": [
        "de",
        "it",
        "en"
      ]
    },
    "support_languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "de",
          "it",
          "en"
        ]
      }
    },
    "response_languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "de",
          "it",
          "en"
        ]
      }
    },
    "translation_status": {
      "enum": [
        "NOT_APPLICABLE",
        "DRAFT",
        "REVIEWED"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "max_points": {
      "type": "number",
      "minimum": 0
    },
    "source_reference": {
      "type": "string"
    },
    "distribution": {
      "enum": [
        "PUBLIC_SYNTHETIC",
        "INTERNAL",
        "RESTRICTED"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restrictions",
        "assessed_competences_per_task"
      ],
      "properties": {
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessed_competences_per_task": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_pack_reference": {
          "type": "string"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "kind",
          "texts"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "PARAGRAPH",
              "EXERCISE"
            ]
          },
          "texts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "points": {
            "type": "number",
            "minimum": 0
          },
          "answer_area": {
            "enum": [
              "NONE",
              "FULL_WIDTH_TEXT",
              "FULL_WIDTH_DRAWING"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "use_case": {
            "const": "ASSESSMENT"
          }
        },
        "required": [
          "use_case"
        ]
      },
      "then": {
        "required": [
          "assessment"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "ASSESSMENT"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "use_case": {
            "const": "ASSESSMENT"
          }
        }
      }
    }
  ]
}
